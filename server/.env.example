# Supabase -> Project Settings -> Database -> Connection string
# IMPORTANT: use the "Session pooler" tab (IPv4), NOT "Direct connection" (IPv6-only)
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Any long random string (Render can auto-generate this)
JWT_SECRET=change-me-to-a-long-random-secret
